{
  "name": "rallypath",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "check:types": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:core": "node --test tests/board-media-core.test.mjs",
    "test": "npm run check:runtime && npm run check:content && npm run check:types && npm run test:core && npm run test:runtime",
    "verify:release": "npm test && npm run build && npm run test:sites && npm run prepare:pages && npm run test:pages",
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "check:content": "node scripts/check-content.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test --workers=1",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:pages": "node --test tests/github-pages.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime && npm run check:content",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "prepare:pages": "node scripts/prepare-github-pages.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
